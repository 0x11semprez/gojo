# Copy this file to .env and fill in the values below.
#   cp .env.example .env
#
# See api/docs/database-rbac.md for why there are two database roles,
# and the "Database setup" section of the README for the exact SQL
# to create them.

# DSN the API uses for normal request handling (CRUD on users/wallets).
# Least-privileged role: SELECT/INSERT/UPDATE/DELETE only, no DDL.
DATABASE_URL="postgres://gojo_api:CHANGE_ME@localhost:5432/gojo"

# DSN used only when applying migrations at startup (see
# api/internal/database/startmigrations.go). This role owns the
# schema and may run CREATE/ALTER/DROP; the API itself never
# connects with it outside of migrations.
DATABASE_URL_MIGRATION="postgres://gojo_migrations:CHANGE_ME@localhost:5432/gojo"

# Port the HTTP server listens on.
PORT=":6969"

# Hex-encoded 32-byte (64 hex chars) AES-256-GCM key: the outer layer
# of a wallet's envelope encryption (see api/docs/api.md). Generate
# your own, never reuse this example value:
#   openssl rand -hex 32
WALLET_ENCRYPTION_KEY="CHANGE_ME"

# Optional: override the path to the compiled rust generator binary.
# Only needed if it isn't at generator/target/release/generator
# relative to the repository root (e.g. in a container image).
# GENERATOR_BIN_PATH=
